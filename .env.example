# Copy this file to .env and fill in your own values.

# Personal access token from https://api.up.com.au
UP_TOKEN=up:yeah:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The ID from your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
SHEET_ID=

# Name of the tab/worksheet to sync into. Created automatically if missing.
SHEET_NAME=Transactions

# Path to the service account JSON key you downloaded from Google Cloud.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# How many days back to fetch + check for category/tag changes on each run.
LOOKBACK_DAYS=90

# If true, each Up account gets its own tab (named after the account's
# display name in Up, e.g. "Spending", "Rainy Day"), instead of one
# combined tab. SHEET_NAME is ignored when this is true.
SPLIT_BY_ACCOUNT=false

# Which accounts to sync:
#   personal - "Up" + "Up Savers" only (individually-owned accounts)
#   joint    - "2Up" + "2Up Savers" only (jointly-owned accounts)
#   all      - every account, personal and joint
ACCOUNT_SCOPE=all

# If true, exclude Saver accounts and only sync spending (transactional)
# accounts — e.g. "Up" but not "Rainy Day", or "2Up" but not "2Up Savers".
# Combines with ACCOUNT_SCOPE: e.g. ACCOUNT_SCOPE=personal +
# SPENDING_ONLY=true syncs just your personal "Up" account.
SPENDING_ONLY=false

# Sort order for transactions in the sheet: "asc" (oldest at top, newest
# at bottom — default) or "desc" (newest at top, oldest at bottom). New
# rows are appended at the bottom for asc, or inserted just below the
# header for desc, keeping the sheet consistently ordered as it grows.
# Only affects where NEW rows land — it doesn't retroactively re-sort
# rows already in the sheet, so avoid switching this after the sheet
# already has data unless you're happy to re-sort it yourself once.
SORT_ORDER=asc
